{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "total": {
      "type": "decimal"
    },
    "statusOrder": {
      "type": "enumeration",
      "enum": [
        "pending",
        "confirmed",
        "canceled"
      ]
    },
    "shippingAddress": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::address.address",
      "inversedBy": "shippingOrders"
    },
    "billingAddress": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::address.address",
      "inversedBy": "billingOrders"
    },
    "paymentMethod": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::payment-method.payment-method",
      "inversedBy": "orders"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    },
    "shippingType": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::shipping-type.shipping-type",
      "inversedBy": "orders"
    },
    "shippingCost": {
      "type": "decimal",
      "description": "Coût de livraison final appliqué à cette commande"
    }
  }
}
