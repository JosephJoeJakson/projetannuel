{
  "kind": "collectionType",
  "collectionName": "creation_categories",
  "info": {
    "singularName": "creation-category",
    "pluralName": "creation-categories",
    "displayName": "CreationCategory",
    "description": "Catégories pour organiser les créations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text",
      "required": false
    },
    "creations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::creation.creation",
      "mappedBy": "creation_categories"
    }
  }
} 